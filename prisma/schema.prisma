generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

model Role {
  role_id          Int           @id @default(autoincrement())
  role_name        String        @db.VarChar(50)
  role_description String?
  permissions      Json          @default("{}")
  is_system_role   Boolean?      @default(false)
  created_at       DateTime?     @default(now())
  updated_at       DateTime?     @default(now())
  agency_id        Int?
  invitations      invitations[]
  agencies         Agency?       @relation(fields: [agency_id], references: [agency_id], onDelete: Cascade)
  users            User[]

  @@unique([agency_id, role_name])
  @@index([agency_id])
  @@map("roles")
}

model Agency {
  agency_id                           Int                       @id @default(autoincrement())
  agency_name                         String                    @db.VarChar(255)
  agency_slug                         String                    @unique @db.VarChar(255)
  industry                            String?                   @db.VarChar(100)
  address                             String?
  city                                String?                   @db.VarChar(100)
  state                               String?                   @db.VarChar(100)
  country                             String?                   @db.VarChar(100)
  postal_code                         String?                   @db.VarChar(20)
  phone                               String?                   @db.VarChar(20)
  email                               String?                   @db.VarChar(255)
  website                             String?                   @db.VarChar(255)
  logo_url                            String?
  plan_type                           String                    @default("trial") @db.VarChar(50)
  subscription_status                 String                    @default("active") @db.VarChar(50)
  subscription_start_date             DateTime?
  subscription_end_date               DateTime?
  billing_email                       String?                   @db.VarChar(255)
  timezone                            String                    @default("UTC") @db.VarChar(100)
  date_format                         String                    @default("YYYY-MM-DD") @db.VarChar(20)
  time_format                         String                    @default("24h") @db.VarChar(20)
  currency                            String                    @default("USD") @db.VarChar(10)
  is_active                           Boolean                   @default(true)
  created_at                          DateTime                  @default(now())
  updated_at                          DateTime                  @updatedAt
  owner_user_id                       Int?
  onboarding_completed_at             DateTime?
  mfa_required                        Boolean                   @default(false)
  feature_flags                       Json                      @default("{}")
  usage_limits                        Json                      @default("{}")
  closed_at                           DateTime?
  users_agencies_owner_user_idTousers User?                     @relation("agencies_owner_user_idTousers", fields: [owner_user_id], references: [user_id])
  chats                               Chat[]
  client_contacts                     client_contacts[]
  client_documents                    client_documents[]
  client_notes                        client_notes[]
  client_onboarding_items             client_onboarding_items[]
  clients                             Client[]
  connectedAccounts                   ConnectedAccount[]
  departments                         Department[]
  invitations                         invitations[]
  invoices                            invoices[]
  leads                               leads[]
  payments                            payments[]
  project_notes                       project_notes[]
  projects                            Project[]
  proposals                           proposals[]
  roles                               Role[]
  security_events                     security_events[]
  teams                               Team[]
  users                               User[]

  googleClientIntegrations GoogleClientIntegration[]

  @@map("agencies")
}

model Department {
  department_id        Int          @id @default(autoincrement())
  agency_id            Int
  department_name      String       @db.VarChar(255)
  department_code      String?      @db.VarChar(50)
  description          String?
  manager_id           Int?
  parent_department_id Int?
  is_active            Boolean?     @default(true)
  created_at           DateTime?    @default(now())
  updated_at           DateTime?    @default(now())
  agency               Agency       @relation(fields: [agency_id], references: [agency_id])
  manager              User?        @relation("ManagerDepartments", fields: [manager_id], references: [user_id])
  parent               Department?  @relation("DepartmentHierarchy", fields: [parent_department_id], references: [department_id])
  sub_departments      Department[] @relation("DepartmentHierarchy")
  teams                Team[]
  users                User[]

  @@unique([agency_id, department_code])
  @@map("departments")
}

model Team {
  team_id       Int         @id @default(autoincrement())
  agency_id     Int
  department_id Int?
  team_name     String      @db.VarChar(255)
  team_code     String?     @db.VarChar(50)
  description   String?
  team_lead_id  Int?
  is_active     Boolean?    @default(true)
  created_at    DateTime?   @default(now())
  updated_at    DateTime?   @default(now())
  agency        Agency      @relation(fields: [agency_id], references: [agency_id])
  department    Department? @relation(fields: [department_id], references: [department_id])
  team_lead     User?       @relation("TeamLead", fields: [team_lead_id], references: [user_id])
  primary_users User[]      @relation("UserPrimaryTeam")
  users         User[]      @relation("UserTeams")

  @@unique([agency_id, team_code])
  @@map("teams")
}

model User {
  user_id                                              Int                       @id @default(autoincrement())
  email                                                String                    @unique @db.VarChar(255)
  password_hash                                        String                    @db.VarChar(255)
  first_name                                           String                    @db.VarChar(100)
  last_name                                            String                    @db.VarChar(100)
  two_factor_enabled                                   Boolean                   @default(false)
  two_factor_secret                                    String?                   @db.VarChar(255)
  is_active                                            Boolean                   @default(true)
  created_at                                           DateTime                  @default(now())
  updated_at                                           DateTime                  @default(now())
  agency_id                                            Int
  avatar_url                                           String?
  bio                                                  String?
  created_by                                           Int?
  date_of_joining                                      DateTime?                 @db.Date
  employee_id                                          String?                   @db.VarChar(50)
  hourly_rate                                          Decimal?                  @db.Decimal(10, 2)
  is_verified                                          Boolean                   @default(false)
  job_title                                            String?                   @db.VarChar(100)
  language                                             String                    @default("en") @db.VarChar(10)
  last_login_at                                        DateTime?
  last_login_ip                                        String?                   @db.VarChar(45)
  mobile                                               String?                   @db.VarChar(20)
  notification_preferences                             Json?                     @default("{}")
  phone                                                String?                   @db.VarChar(20)
  role_id                                              Int
  timezone                                             String                    @default("UTC") @db.VarChar(100)
  department_id                                        Int?
  full_name                                            String?                   @db.VarChar(255)
  team_id                                              Int?
  is_platform_admin                                    Boolean                   @default(false)
  user_type                                            String                    @default("staff") @db.VarChar(20)
  client_id                                            Int?
  email_verified_at                                    DateTime?
  password_changed_at                                  DateTime?
  failed_login_count                                   Int                       @default(0)
  locked_until                                         DateTime?
  two_factor_backup_codes                              Json?
  two_factor_last_step                                 Int?
  deactivated_at                                       DateTime?
  activity_logs                                        ActivityLog[]
  agencies_agencies_owner_user_idTousers               Agency[]                  @relation("agencies_owner_user_idTousers")
  auth_tokens                                          auth_tokens[]
  messageReads                                         ChatMessageRead[]
  sentMessages                                         ChatMessage[]             @relation("MessageSender")
  chatParticipants                                     ChatParticipant[]
  chatReactions                                        ChatReaction[]
  createdChats                                         Chat[]                    @relation("ChatCreatedBy")
  client_contacts                                      client_contacts[]
  client_documents                                     client_documents[]
  client_notes                                         client_notes[]
  client_onboarding_items                              client_onboarding_items[]
  managed_clients                                      Client[]                  @relation("AccountManagedClients")
  created_clients                                      Client[]                  @relation("CreatedClients")
  portal_clients                                       Client[]                  @relation("PortalClients")
  connectedAccounts                                    ConnectedAccount[]
  manager_of_departments                               Department[]              @relation("ManagerDepartments")
  e2ee_devices                                         e2ee_devices[]
  invitations_invitations_accepted_user_idTousers      invitations[]             @relation("invitations_accepted_user_idTousers")
  invitations_invitations_invited_byTousers            invitations[]             @relation("invitations_invited_byTousers")
  invoices                                             invoices[]
  leads_leads_created_byTousers                        leads[]                   @relation("leads_created_byTousers")
  leads_leads_owner_idTousers                          leads[]                   @relation("leads_owner_idTousers")
  notificationPreferences                             notification_preferences? @relation("UserNotificationPreferences")
  notifications                                        Notification[]
  payments                                             payments[]
  added_project_members                                ProjectMember[]           @relation("AddedByProjects")
  project_members                                      ProjectMember[]           @relation("UserProjects")
  project_notes                                        project_notes[]
  archived_projects                                    Project[]                 @relation("ProjectArchivedBy")
  created_projects                                     Project[]                 @relation("ProjectCreatedBy")
  managed_projects                                     Project[]
  proposals                                            proposals[]
  security_events_security_events_actor_user_idTousers security_events[]         @relation("security_events_actor_user_idTousers")
  security_events_security_events_user_idTousers       security_events[]         @relation("security_events_user_idTousers")
  assigned_tasks                                       TaskAssignment[]          @relation("TaskAssignedBy")
  removed_tasks                                        TaskAssignment[]          @relation("TaskRemovedBy")
  task_assignments                                     TaskAssignment[]          @relation("UserTaskAssignments")
  deleted_attachments                                  TaskAttachment[]          @relation("TaskAttachmentsDeletedBy")
  uploaded_attachments                                 TaskAttachment[]          @relation("TaskAttachmentsUploadedBy")
  task_comments                                        TaskComment[]
  approved_tasks                                       Task[]                    @relation("TaskApprovedBy")
  created_tasks                                        Task[]                    @relation("TaskCreatedBy")
  lead_of_teams                                        Team[]                    @relation("TeamLead")
  approved_time_logs                                   TimeLog[]                 @relation("TimeLogsApprovedBy")
  time_logs                                            TimeLog[]
  user_sessions                                        user_sessions[]
  agency                                               Agency                    @relation(fields: [agency_id], references: [agency_id])
  clients_users_client_idToclients                     Client?                   @relation("users_client_idToclients", fields: [client_id], references: [client_id])
  creator                                              User?                     @relation("UserCreatedBy", fields: [created_by], references: [user_id])
  createdUsers                                         User[]                    @relation("UserCreatedBy")
  department                                           Department?               @relation(fields: [department_id], references: [department_id])
  role                                                 Role                      @relation(fields: [role_id], references: [role_id])
  team                                                 Team?                     @relation("UserPrimaryTeam", fields: [team_id], references: [team_id])
  weeklyPlans                                          WeeklyPlan[]
  teams                                                Team[]                    @relation("UserTeams")

  @@map("users")
}

model Client {
  client_id                      Int                       @id @default(autoincrement())
  agency_id                      Int
  address                        String?
  company_name                   String                    @db.VarChar(255)
  website                        String?                   @db.VarChar(255)
  notes                          String?
  is_active                      Boolean                   @default(true)
  created_at                     DateTime                  @default(now())
  updated_at                     DateTime                  @updatedAt
  account_manager_id             Int?
  billing_address                String?
  billing_email                  String?                   @db.VarChar(255)
  brand_colors                   Json?
  brand_guidelines_url           String?
  city                           String?                   @db.VarChar(100)
  client_since                   DateTime?                 @db.Date
  company_size                   String?                   @db.VarChar(50)
  country                        String?                   @db.VarChar(100)
  created_by                     Int?
  industry                       String?                   @db.VarChar(100)
  logo_url                       String?
  onboarding_status              String                    @default("pending")
  payment_terms                  Int?                      @default(30)
  portal_enabled                 Boolean                   @default(true)
  portal_user_id                 Int?
  postal_code                    String?                   @db.VarChar(20)
  primary_contact_email          String?                   @db.VarChar(255)
  primary_contact_name           String?                   @db.VarChar(255)
  primary_contact_phone          String?                   @db.VarChar(20)
  state                          String?                   @db.VarChar(100)
  status                         String                    @default("active")
  tax_id                         String?                   @db.VarChar(50)
  chats                          Chat[]
  client_contacts                client_contacts[]
  client_documents               client_documents[]
  client_notes                   client_notes[]
  client_onboarding_items        client_onboarding_items[]
  manager                        User?                     @relation("AccountManagedClients", fields: [account_manager_id], references: [user_id])
  agency                         Agency                    @relation(fields: [agency_id], references: [agency_id])
  creator                        User?                     @relation("CreatedClients", fields: [created_by], references: [user_id])
  portal_user                    User?                     @relation("PortalClients", fields: [portal_user_id], references: [user_id])
  connectedAccounts              ConnectedAccount[]
  invitations                    invitations[]
  invoices                       invoices[]
  leads                          leads[]
  projects                       Project[]
  proposals                      proposals[]
  users_users_client_idToclients User[]                    @relation("users_client_idToclients")

  googleClientIntegrations GoogleClientIntegration[]

  @@map("clients")
}

model Project {
  project_id          Int             @id @default(autoincrement())
  agency_id           Int
  client_id           Int?
  project_name        String          @db.VarChar(255)
  description         String?
  budget_amount       Decimal?        @db.Decimal(12, 2)
  budget_currency     String?         @default("USD") @db.VarChar(10)
  auto_task_numbering Boolean?        @default(true)
  task_prefix         String?         @db.VarChar(10)
  start_date          DateTime        @db.Date
  end_date            DateTime?       @db.Date
  status              String?         @default("planning") @db.VarChar(50)
  created_at          DateTime?       @default(now())
  updated_at          DateTime?       @updatedAt
  actual_hours        Decimal?        @default(0) @db.Decimal(10, 2)
  archived_at         DateTime?
  archived_by         Int?
  billing_type        String?         @db.VarChar(50)
  created_by          Int?
  custom_fields       Json?
  estimated_hours     Decimal?        @db.Decimal(10, 2)
  is_active           Boolean?        @default(true)
  is_archived         Boolean?        @default(false)
  is_billable         Boolean?        @default(true)
  is_public           Boolean?        @default(false)
  notes               String?
  priority            String?         @default("medium") @db.VarChar(20)
  progress_percentage Int?            @default(0)
  project_code        String          @db.VarChar(50)
  project_manager_id  Int
  project_type        String?         @db.VarChar(100)
  tags                String[]
  chats               Chat[]
  projectMembers      ProjectMember[]
  project_notes       project_notes[]
  agency              Agency          @relation(fields: [agency_id], references: [agency_id])
  archivedBy          User?           @relation("ProjectArchivedBy", fields: [archived_by], references: [user_id])
  client              Client?         @relation(fields: [client_id], references: [client_id])
  createdBy           User?           @relation("ProjectCreatedBy", fields: [created_by], references: [user_id])
  manager             User            @relation(fields: [project_manager_id], references: [user_id])
  tasks               Task[]
  time_logs           TimeLog[]
  weeklyPlans         WeeklyPlan[]

  @@map("projects")
}

model ProjectMember {
  member_id       Int       @id @default(autoincrement())
  project_id      Int
  user_id         Int
  role_in_project String?   @db.VarChar(100)
  hourly_rate     Decimal?  @db.Decimal(10, 2)
  is_active       Boolean?  @default(true)
  joined_at       DateTime? @default(now())
  left_at         DateTime?
  added_by        Int?
  added_by_user   User?     @relation("AddedByProjects", fields: [added_by], references: [user_id])
  project         Project   @relation(fields: [project_id], references: [project_id])
  user            User      @relation("UserProjects", fields: [user_id], references: [user_id])

  @@unique([project_id, user_id, is_active])
  @@map("project_members")
}

model Task {
  task_id                                       Int              @id @default(autoincrement())
  project_id                                    Int
  task_title                                    String           @db.VarChar(500)
  description                                   String?
  task_number                                   String?          @db.VarChar(50)
  is_milestone                                  Boolean          @default(false)
  depends_on                                    Int[]            @default([])
  blocks                                        Int[]            @default([])
  assigned_date                                 DateTime?
  visible_to_client                             Boolean          @default(false)
  client_approval_required                      Boolean          @default(false)
  client_approved                               Boolean          @default(false)
  client_approved_at                            DateTime?
  client_approved_by                            Int?
  created_at                                    DateTime         @default(now())
  updated_at                                    DateTime         @updatedAt
  created_by                                    Int?
  actual_hours                                  Decimal          @default(0) @db.Decimal(8, 2)
  assigned_to                                   Int[]            @default([])
  checklist                                     Json?
  completed_at                                  DateTime?
  custom_fields                                 Json?
  due_date                                      DateTime?        @db.Date
  estimated_hours                               Decimal?         @db.Decimal(8, 2)
  is_billable                                   Boolean          @default(true)
  is_recurring                                  Boolean          @default(false)
  parent_task_id                                Int?
  priority                                      String?          @default("medium") @db.VarChar(20)
  progress_percentage                           Int              @default(0)
  recurrence_pattern                            Json?
  start_date                                    DateTime?        @db.Date
  status                                        String?          @default("to_do") @db.VarChar(50)
  tags                                          String[]         @default([])
  task_type                                     String?          @db.VarChar(100)
  weekly_plan_id                                Int?
  client_approval_status                        String?          @db.VarChar(30)
  client_feedback                               String?
  client_feedback_at                            DateTime?
  recurrence_next_run_at                        DateTime?
  recurrence_source_id                          Int?
  recurrence_date                               DateTime?        @db.Date
  chatMessages                                  ChatMessage[]
  chats                                         Chat[]
  assignments                                   TaskAssignment[]
  attachments                                   TaskAttachment[]
  comments                                      TaskComment[]
  approvedBy                                    User?            @relation("TaskApprovedBy", fields: [client_approved_by], references: [user_id])
  createdBy                                     User?            @relation("TaskCreatedBy", fields: [created_by], references: [user_id])
  parent_task                                   Task?            @relation("TaskHierarchy", fields: [parent_task_id], references: [task_id], onDelete: Cascade)
  subtasks                                      Task[]           @relation("TaskHierarchy")
  project                                       Project          @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  tasks_tasks_recurrence_source_idTotasks       Task?            @relation("tasks_recurrence_source_idTotasks", fields: [recurrence_source_id], references: [task_id])
  other_tasks_tasks_recurrence_source_idTotasks Task[]           @relation("tasks_recurrence_source_idTotasks")
  weeklyPlan                                    WeeklyPlan?      @relation(fields: [weekly_plan_id], references: [weekly_plan_id])
  timeLogs                                      TimeLog[]

  @@unique([recurrence_source_id, recurrence_date])
  @@index([due_date])
  @@index([is_recurring, recurrence_next_run_at])
  @@index([project_id])
  @@map("tasks")
}

model TaskAssignment {
  task_id       Int
  user_id       Int
  assigned_at   DateTime? @default(now())
  removed_at    DateTime?
  removed_by    Int?
  assigned_by   Int?
  assignment_id Int       @id @default(autoincrement())
  is_active     Boolean?  @default(true)
  assignedBy    User?     @relation("TaskAssignedBy", fields: [assigned_by], references: [user_id])
  removedBy     User?     @relation("TaskRemovedBy", fields: [removed_by], references: [user_id])
  task          Task      @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  user          User      @relation("UserTaskAssignments", fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([task_id, user_id, is_active])
  @@map("task_assignments")
}

model TaskComment {
  comment_id        Int           @id @default(autoincrement())
  task_id           Int
  parent_comment_id Int?
  user_id           Int
  comment_text      String
  mentioned_users   Int[]         @default([])
  is_edited         Boolean?      @default(false)
  edited_at         DateTime?
  is_deleted        Boolean?      @default(false)
  deleted_at        DateTime?
  created_at        DateTime?     @default(now())
  updated_at        DateTime?     @default(now())
  parent            TaskComment?  @relation("CommentReplies", fields: [parent_comment_id], references: [comment_id])
  replies           TaskComment[] @relation("CommentReplies")
  task              Task          @relation(fields: [task_id], references: [task_id])
  user              User          @relation(fields: [user_id], references: [user_id])

  @@map("task_comments")
}

model TaskAttachment {
  attachment_id      Int       @id @default(autoincrement())
  task_id            Int
  file_name          String    @db.VarChar(500)
  file_path          String
  file_size          BigInt
  file_extension     String?   @db.VarChar(20)
  image_width        Int?
  image_height       Int?
  is_deleted         Boolean?  @default(false)
  deleted_at         DateTime?
  deleted_by         Int?
  file_original_name String    @db.VarChar(500)
  file_type          String?   @db.VarChar(100)
  file_url           String
  uploaded_at        DateTime? @default(now())
  uploaded_by        Int?
  resource_type      String?   @db.VarChar(20)
  storage_type       String    @default("upload") @db.VarChar(20)
  deletedBy          User?     @relation("TaskAttachmentsDeletedBy", fields: [deleted_by], references: [user_id])
  task               Task      @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  uploadedBy         User?     @relation("TaskAttachmentsUploadedBy", fields: [uploaded_by], references: [user_id])

  @@map("task_attachments")
}

model TimeLog {
  task_id          Int
  user_id          Int
  start_time       DateTime
  end_time         DateTime?
  hourly_rate      Decimal?  @db.Decimal(10, 2)
  log_type         String?   @default("automatic") @db.VarChar(20)
  approved_at      DateTime?
  is_invoiced      Boolean?  @default(false)
  invoice_id       Int?
  created_at       DateTime? @default(now())
  updated_at       DateTime? @updatedAt
  approved_by      Int?
  description      String?
  duration_minutes Int?
  is_approved      Boolean?  @default(false)
  is_billable      Boolean?  @default(true)
  log_id           Int       @id @default(autoincrement())
  project_id       Int
  approvedBy       User?     @relation("TimeLogsApprovedBy", fields: [approved_by], references: [user_id])
  project          Project   @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  task             Task      @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  user             User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("time_logs")
}

model Notification {
  notification_id   Int       @id @default(autoincrement())
  user_id           Int
  title             String    @db.VarChar(500)
  message           String
  entity_type       String?   @db.VarChar(50)
  entity_id         Int?
  action_url        String?
  is_read           Boolean   @default(false)
  read_at           DateTime?
  sent_via_email    Boolean   @default(false)
  email_sent_at     DateTime?
  sent_via_push     Boolean   @default(false)
  push_sent_at      DateTime?
  created_at        DateTime  @default(now())
  notification_type String    @db.VarChar(100)
  user              User      @relation(fields: [user_id], references: [user_id])

  @@index([user_id, created_at])
  @@map("notifications")
}

model ActivityLog {
  user_id     Int?
  user_email  String?   @db.VarChar(255)
  user_name   String?   @db.VarChar(255)
  action      String    @db.VarChar(100)
  entity_type String    @db.VarChar(50)
  entity_id   Int
  entity_name String?   @db.VarChar(500)
  description String?
  changes     Json?
  ip_address  String?   @db.VarChar(45)
  user_agent  String?
  created_at  DateTime? @default(now())
  log_id      Int       @id @default(autoincrement())
  agency_id   Int?
  client_id   Int?
  user        User?     @relation(fields: [user_id], references: [user_id])

  @@index([agency_id, created_at])
  @@index([client_id, created_at])
  @@map("activity_logs")
}

model Chat {
  chat_id         Int               @id @default(autoincrement())
  agency_id       Int
  chat_type       String            @db.VarChar(50)
  chat_name       String?           @db.VarChar(255)
  project_id      Int?
  task_id         Int?
  created_by      Int?
  last_message_id Int?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  client_id       Int?
  is_encrypted    Boolean           @default(true)
  encrypted_since DateTime?         @default(now())
  messages        ChatMessage[]
  participants    ChatParticipant[]
  agency          Agency            @relation(fields: [agency_id], references: [agency_id])
  clients         Client?           @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  creator         User?             @relation("ChatCreatedBy", fields: [created_by], references: [user_id])
  project         Project?          @relation(fields: [project_id], references: [project_id])
